{
  "displayName": "ITCS355 Prediction service",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "Request rate",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "all requests"
            }
          ],
          "yAxis": {
            "label": "req/s",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Errors by class",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\" AND metric.label.response_code_class=\"4xx\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "4xx (caller)"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\" AND metric.label.response_code_class=\"5xx\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "5xx (ours)"
            }
          ],
          "yAxis": {
            "label": "req/s",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Latency p50 / p95 / p99",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_50",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "p50"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "p95"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"itcs355-serve-staging\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_99",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": []
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "p99"
            }
          ],
          "yAxis": {
            "label": "ms",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Feature drift: PSI per feature, rolling window",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.temp_c\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "temp_c"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.vibration_mm_s\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "vibration_mm_s"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.pressure_kpa\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "pressure_kpa"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.hours_since_service\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "hours_since_service"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.load_pct\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "load_pct"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.psi.ambient_humidity\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "ambient_humidity"
            }
          ],
          "yAxis": {
            "label": "PSI",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Features over their drift limit",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/mlaiops/drift.breached_features\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "breached"
            }
          ],
          "yAxis": {
            "label": "count",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Requests by model version",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/predict_by_model_version\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": [
                      "metric.label.model_version"
                    ]
                  }
                }
              },
              "plotType": "LINE",
              "legendTemplate": "model v${metric.label.model_version}"
            }
          ],
          "yAxis": {
            "label": "req/s",
            "scale": "LINEAR"
          }
        }
      }
    ]
  }
}
