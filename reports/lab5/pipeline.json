  "pipelineInfo": {
    "name": "itcs355-training-pipeline"
  },
  "root": {
    "dag": {
      "tasks": {
        "condition-1": {
          "componentRef": {
            "name": "comp-condition-1"
          },
          "dependentTasks": [
            "sh-4"
          ],
          "inputs": {
            "parameters": {
              "pipelinechannel--sh-4-out": {
                "taskOutputParameter": {
                  "outputParameterKey": "out",
                  "producerTask": "sh-4"
                }
              }
            }
          },
          "taskInfo": {
            "name": "condition-1"
          },
          "triggerPolicy": {
            "condition": "inputs.parameter_values['pipelinechannel--sh-4-out'] == 'pass'"
          }
        },
        "sh": {
          "cachingOptions": {},
          "componentRef": {
            "name": "comp-sh"
          },
          "inputs": {
            "parameters": {
              "a": {
                "runtimeValue": {
                  "constant": "-"
                }
              },
              "b": {
                "runtimeValue": {
                  "constant": "-"
                }
              },
              "script": {
                "runtimeValue": {
                  "constant": "mkdir -p \"$(dirname \"$1\")\" && dvc pull && test -s data/raw/sensors.csv && sha256sum data/raw/sensors.csv > \"$1\""
                }
              }
            }
          },
          "taskInfo": {
            "name": "ingest"
          }
        },
        "sh-2": {
          "cachingOptions": {},
          "componentRef": {
            "name": "comp-sh-2"
          },
          "dependentTasks": [
            "sh"
          ],
          "inputs": {
            "parameters": {
              "a": {
                "runtimeValue": {
                  "constant": "-"
                }
              },
              "b": {
                "runtimeValue": {
                  "constant": "-"
                }
              },
              "script": {
                "runtimeValue": {
                  "constant": "mkdir -p \"$(dirname \"$1\")\" && dvc pull && test -s data/raw/sensors.csv && { python -m pytest -q -rs tests/test_data.py > /tmp/t.txt 2>&1; rc=$?; cat /tmp/t.txt; [ $rc -eq 0 ] && ! grep -qi skipped /tmp/t.txt && echo ok > \"$1\"; }"
                }
              }
            }
          },
          "taskInfo": {
            "name": "validate"
          }
        },
        "sh-3": {
          "cachingOptions": {},
          "componentRef": {
            "name": "comp-sh-3"
          },
          "dependentTasks": [
            "sh-2"
          ],
          "inputs": {
            "parameters": {
              "a": {
                "runtimeValue": {
                  "constant": "/gcs/itcs355-6688165/itcs355/lab5/runs/{{$.pipeline_job_uuid}}"
                }
              },
              "b": {
                "runtimeValue": {
                  "constant": "-"
                }
              },
              "script": {
                "runtimeValue": {
                  "constant": "mkdir -p \"$(dirname \"$1\")\" && dvc pull && python -m src.train --no-track --metrics-out \"$2/metrics.json\" --model-out \"$2/model\" && echo done > \"$1\""
                }
              }
            }
          },
          "taskInfo": {
            "name": "train"
          }
        },
        "sh-4": {
          "cachingOptions": {},
          "componentRef": {
            "name": "comp-sh-4"
          },
          "dependentTasks": [
            "sh-3"
          ],
          "inputs": {
            "parameters": {
              "a": {
                "runtimeValue": {
                  "constant": "/gcs/itcs355-6688165/itcs355/lab5/runs/{{$.pipeline_job_uuid}}"
                }
              },
              "b": {
                "componentInputParameter": "incumbent_arg"
              },
              "script": {
                "runtimeValue": {
                  "constant": "mkdir -p \"$(dirname \"$1\")\" && python scripts/evaluation_gate.py --metrics \"$2/metrics.json\" $3 --decision-out \"$1\"; tr -d \"[:space:]\" < \"$1\" > /tmp/d && cp /tmp/d \"$1\""
                }
              }
            }
          },
          "taskInfo": {
            "name": "evaluate"
          }
        }
      }
    },
    "inputDefinitions": {
      "parameters": {
        "incumbent_arg": {
          "defaultValue": "--incumbent-alias staging",
          "isOptional": true,
          "parameterType": "STRING"
        }
      }
    }
