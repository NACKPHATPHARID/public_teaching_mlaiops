# ITCS355 Lab 3 — serving image
#
# Base pinned by digest: same as the Lab 1 training image (the 3.11-slim tag has since
# moved to da047cb...), so training and serving run on an identical base.
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --prefix=/install -r requirements-serve.txt

FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

# Provider route differences are absorbed in cloudlayer/gcp.py, not here.
#   Cloud Run: no fixed paths; the startup probe points at /ready in the deploy config.
#   Vertex AI: would declare --container-health-route=/ready and
#              --container-predict-route=/predict on the Model, also in the adapter.
# Routes in service/app.py are unchanged; the image only honours the injected $PORT.
ENV PORT=8080
EXPOSE 8080
CMD exec uvicorn service.app:app --host 0.0.0.0 --port ${PORT} --workers 2
